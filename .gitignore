# Reference material, never versioned here: notes on other systems and
# the proof-of-concept authoring skill, which will be rewritten.
.input/

# Personal working notes, never versioned.
transient/

# Local build (task build). Never the root: proviso/ is the spec tree.
bin/

# Release archives built locally (task snapshot).
dist/

# The Windows version resource, written by task versioninfo and before a
# release; its source is cmd/proviso/versioninfo.json.
cmd/proviso/resource_windows_*.syso

# The kit as installed into this repository by `task install`; its source
# is internal/kit/.
.claude/agents/proviso-*
.claude/skills/proviso-*

# Test artifacts
*.test
*.out
coverage.*

# Local environment
.env
*.local

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

  "findings": [
    {
      "id": "f1",
      "kind": "gap",
      "elements": [
        "baseline.diff.former",
        "baseline.impact",
        "baseline.impact.events"
      ],
      "text": "The third Provided step of baseline.diff.former now depends on which former text the command reads, but for impact the tree says only that it 'derives the element diff as diff does'. It is not decided whether impact reads the former text of every changed and removed part, as diff does, or only the baseline When steps that baseline.impact.events needs. So whether impact refuses a tree that diff refuses, or accepts one diff accepts, is left open.",
      "status": "resolved",
      "reason": "edited in 1f29863"
    },
    {
      "id": "f2",
      "kind": "gap",
      "elements": [
        "baseline.diff.former",
        "baseline.verify"
      ],
      "text": "verify derives the element diff and the candidates as impact does, and baseline.impact.events reads the event head of a touched rule 'in the baseline', which is former text from git. But the When of baseline.diff.former names only diff, impact and pack, so no rule says where verify reads that former text, what it checks first, or what it does when it cannot read it.",
      "status": "resolved",
      "reason": "edited in 1f29863"
    },
    {
      "id": "f3",
      "kind": "gap",
      "elements": [
        "baseline.diff.malformed",
        "baseline.diff.former",
        "baseline.judge",
        "baseline.verify"
      ],
      "text": "baseline.diff.former now names judge and verify beside diff, impact and pack, but baseline.diff.malformed, the rule for a manifest line that cannot be read, still names only diff, impact and pack and their exit statuses. judge and verify read manifest_file too, since they derive the element diff as impact does, so no rule says what they do with a damaged manifest, such as a merge conflict left in it.",
      "status": "resolved",
      "reason": "edited in fe0d365"
    },
    {
      "id": "f4",
      "kind": "gap",
      "elements": [
        "baseline.diff.malformed",
        "baseline.diff.former",
        "baseline.judge.input"
      ],
      "text": "baseline.diff.malformed and baseline.diff.former now stop judge with exit status 2 when manifest_file or the former text cannot be read, and baseline.judge.input stops it with exit status 1 when its input is no check_result. The judge feature orders only coherence_file before both (\"before it reads its input or derives the element diff\"). No rule decides whether the input or the element diff comes first, so a run with input that is not JSON and a damaged manifest_file (or a manifest committed with a tree that differs from it) may exit with 1 or with 2.",
      "status": "resolved",
      "reason": "edited in a6ed768"
    }
  ]
}

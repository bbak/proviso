  "findings": [
    {
      "id": "f1",
      "kind": "gap",
      "elements": [
        "baseline.pack.order",
        "system.cli.pack-text",
        "system.cli.element-diff"
      ],
      "text": "The new Then orders elements by the path of their file and where they stand in it, but a removed element listed under \"Amendment\" no longer stands in the tree (element_diff gives it no file and no line), so no rule says where it appears. The former order by identifier covered removed elements; the new one does not.",
      "status": "resolved",
      "reason": "edited in 1796875"
    },
    {
      "id": "f2",
      "kind": "ignored",
      "elements": [
        "baseline.pack.order",
        "system.platforms"
      ],
      "text": "The rule compares 'the path of their file below the spec root' byte by byte but does not say how the path is written: which separator, and which Unicode form. With a backslash or a slash and with NFC or NFD names the byte order differs, so the order of pack_text could differ between platforms. system.platforms requires such a difference to be decided in the tree, and the rule's own Rationale says it means the same order on every platform.",
      "status": "resolved",
      "reason": "edited in 1796875"
    },
    {
      "id": "f3",
      "kind": "contradiction",
      "elements": [
        "baseline.pack.order",
        "system.cli.diff",
        "system.cli.diff.exit-status",
        "system.cli.diff.json",
        "system.cli.diff.since"
      ],
      "text": "Examples row 3 of baseline.pack.order gives `system.cli.diff`, `.json`, `.since`, `.exit-status` as 'the members as the contract gives them', but contracts/cli.md holds them in the order `system.cli.diff`, `.exit-status`, `.json`, `.since`. Under the new Then, the real tree would give a different outcome from the one the row names.",
      "status": "dismissed",
      "reason": "The contract file holds json, since, exit-status (lines 113, 118, 125); the order read was the pack's identifier order this amendment replaces."
    }
  ]

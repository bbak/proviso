    {
      "id": "f1",
      "kind": "contradiction",
      "elements": [
        "baseline.verify.undecided",
        "lint.glossary.open",
        "baseline.run.lint"
      ],
      "text": "The fifth Examples row of baseline.verify.undecided expects nothing reported for an open glossary entry with its Definition written, but lint.glossary.open makes such an entry a lint error, and baseline.run.lint then makes verify exit 2 before this rule is reached. Every entry lint accepts as open has Definition \"?\", which is itself an undecided place, so verify reports every open entry as \"undecided\" even when no rule marks it. That contradicts the row's why: \"an open term decides nothing until a rule marks it\".",
      "status": "resolved",
      "reason": "edited in 7bc6863"
    },
    {
      "id": "f2",
      "kind": "gap",
      "elements": [
        "baseline.verify.missing",
        "baseline.verify.leftover",
        "baseline.verify.undecided"
      ],
      "text": "baseline.verify.missing and baseline.verify.leftover end their Otherwise with \"verify looks no further\", written before the undecided check existed. No rule says whether that stop also skips the whole-tree check of baseline.verify.undecided, so a tree that is both \"missing\" (or \"leftover\") and undecided may report one problem or several.",
      "status": "resolved",
      "reason": "edited in 9d6545e"
    }

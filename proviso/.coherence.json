  "findings": [
    {
      "id": "f1",
      "kind": "gap",
      "elements": [
        "install.init.skeleton"
      ],
      "text": "The Rationale takes the name in NFC 'as Proviso reports every name', but the system level states NFC only for lint's report (`lint.cli.report`: paths and `root`); no system-level element says every name Proviso reports or writes is in NFC, so the reason given rests on a rule the tree does not hold.",
      "status": "resolved",
      "reason": "edited in 0554902"
    },
    {
      "id": "f2",
      "kind": "gap",
      "elements": [
        "baseline.judge.unreadable",
        "baseline.pack.note-unreadable"
      ],
      "text": "Both Rationales refuse a symbolic link 'as lint follows none', tying baseline to a decision of the lint capability; that Proviso follows no symbolic link is not stated at system level, so the two capabilities can drift apart unseen.",
      "status": "resolved",
      "reason": "edited in 0554902"
    },
    {
      "id": "f3",
      "kind": "gap",
      "elements": [
        "baseline.judge.unreadable",
        "baseline.pack.note-unreadable",
        "system.platforms"
      ],
      "text": "Both guards now need a \"regular file\", but the tree never says which entries count as one on Windows, apart from symbolic links. A file that is a reparse point without being a link, such as a OneDrive placeholder or a deduplicated file, is either read or stops the command with 2 depending on how the code classifies it. `system.platforms` requires such a platform difference to be decided in the tree.",
      "status": "dismissed",
      "reason": "regular file means what the platform calls one, as in lint; how Windows reparse points count is decided once at system level in a later amendment"
    }
  ]
}
